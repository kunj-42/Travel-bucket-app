{
  "expo": {
    "name": "Bucket",
    "slug": "travel-bucket-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "bucket",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#E9EFEC"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kunjbhujwala.bucket",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.kunjbhujwala.bucket",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E9EFEC"
      }
    },
    "plugins": ["expo-router", "expo-font"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
