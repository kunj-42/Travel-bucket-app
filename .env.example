# Copy this file to `.env` and paste your API keys.
# `.env` is gitignored — your real keys never go to GitHub.

# Google Places API (New) — used for city + place autocomplete, photos, and
# accurate Maps deep links.
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=your-key-here

# Google Gemini — used by the "For you" suggestions engine. Gemini Flash reads
# your saved list and proposes 5 new places that match its taste signals.
# Free tier at aistudio.google.com (no billing required): 15 requests/minute,
# 1,500 requests/day.
EXPO_PUBLIC_GEMINI_API_KEY=your-key-here
