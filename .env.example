# Copy this file to `.env` and paste your API keys.
# `.env` is gitignored — your real keys never go to GitHub.

# Google Places API (New) — used for city + place autocomplete, photos, and
# accurate Maps deep links.
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=your-key-here

# Anthropic — used by the "For you" suggestions engine. Claude reads your saved
# list and proposes 5 new places that match the taste signals in it. Get a key
# at console.anthropic.com. Roughly $0.005 per suggestion refresh on Haiku.
EXPO_PUBLIC_ANTHROPIC_API_KEY=your-key-here
